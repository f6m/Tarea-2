from __future__ import division
from sympy import * # todo de sympy

#Simbolos
y0,y1,y2,y3,y4=symbols('y0,y1,y2,y3,y4')

#Funciones multivariables coordenadas, coloque y0=1,y4=4 y 2.4525
def f1(y1,y2,y3):  return 1-2*y1+y2+(2.4525)*sin(y1)
def f2(y1,y2,y3):  return y1-2*y2+y3+(2.4525)*sin(y2)
def f3(y1,y2,y3):  return y2-2*y3+4+(2.4525)*sin(y3)

def f(x): return [f1(x),f2(x),f3(x)]

eq1 = Eq(f1(y1,y2,y3),0)
#eq1 = Eq(y0-2*y1+y2+(2.4525)*sin(y1),0)
eq2 = Eq(f2(y1,y2,y3),0)
eq3 = Eq(f3(y1,y2,y3),0)

solv = nsolve([eq1, eq2, eq3], [y1,y2,y3], [1,2,3], prec=5)
print(solv)

print(f1(solv[0],solv[1],solv[2]))
print(f2(solv[0],solv[1],solv[2]))
print(f3(solv[0],solv[1],solv[2]))
